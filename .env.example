# Select exactly one provider. Supported values: gemini, groq.
LLM_PROVIDER=gemini
# Optional override for the selected provider's provider-specific model.
LLM_MODEL=

# Gemini requires GEMINI_API_KEY and GEMINI_MODEL unless LLM_MODEL is set.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=your-gemini-model

# Groq requires GROQ_API_KEY; the default model is openai/gpt-oss-20b.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b

LLM_TEMPERATURE=0
# Blank means provider default.
LLM_MAX_OUTPUT_TOKENS=
LLM_TIMEOUT_SECONDS=30
